# Copy this file to .env.local and fill it in. Never commit .env.local.

# --- Required: Meta ---------------------------------------------------------
# System User token from Business Settings > Users > System users > Generate new token.
# Permissions: ads_management, ads_read, business_management, pages_show_list,
# pages_read_engagement, pages_manage_ads. Expiry: Never. See the Setup page.
META_ACCESS_TOKEN=

# Optional but recommended: App settings > Basic > App secret. Adds appsecret_proof.
META_APP_SECRET=

# Graph API version. v25.0 is current and supported until mid-2028.
META_API_VERSION=v25.0

# --- Optional: password-protect the app (set this if you host it online) ----
APP_PASSWORD=

# --- Optional: Supabase (needed only when hosting online) -------------------
# Without these, creatives are stored in ./.data/uploads on this computer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=creatives
