    "custom_liquid_QQwhib": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>.ninu-wrap{--bg:#F5EFE6;--card:#FBF7F0;--ink:#241812;--muted:#7A6A5C;--line:#E4D9CB;--acc:#B85A3E;--acc-2:#8E3F27;--gold:#C79A5A;--sage:#5C7A55;--white:#fff;font-family:'Inter','Helvetica Neue',Arial,sans-serif;color:var(--ink);background:var(--bg);box-sizing:border-box;line-height:1.5}.ninu-wrap *,.ninu-wrap *::before,.ninu-wrap *::after{box-sizing:border-box}.ninu-wrap img{max-width:100%;display:block}.ninu-topbar{background:var(--ink);color:#F0E6D8;font-size:12px;letter-spacing:.14em;text-transform:uppercase;text-align:center;padding:10px 14px}.ninu-nav{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;border-bottom:1px solid var(--line);background:var(--bg)}.ninu-logo{font-family:'Cormorant Garamond',Georgia,serif;font-size:30px;letter-spacing:.28em;font-weight:500}.ninu-cart-btn{background:none;border:1px solid var(--ink);border-radius:999px;padding:9px 16px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;display:flex;gap:8px;align-items:center;color:var(--ink)}.ninu-cart-btn .ninu-cart-count{background:var(--acc);color:#fff;border-radius:999px;min-width:20px;height:20px;font-size:11px;display:inline-flex;align-items:center;justify-content:center;padding:0 6px}.ninu-pdp{max-width:1240px;margin:0 auto;padding:36px 28px 60px;display:grid;grid-template-columns:1.05fr 1fr;gap:56px}@media(max-width:900px){.ninu-pdp{grid-template-columns:1fr;gap:28px;padding:20px 16px 40px}}.ninu-gallery{display:grid;grid-template-columns:80px 1fr;gap:14px}@media(max-width:900px){.ninu-gallery{grid-template-columns:1fr}}.ninu-thumbs{display:flex;flex-direction:column;gap:10px}@media(max-width:900px){.ninu-thumbs{flex-direction:row;overflow-x:auto}}.ninu-thumb{width:80px;height:96px;background:var(--card);border:1px solid var(--line);border-radius:6px;overflow:hidden;cursor:pointer;flex-shrink:0}.ninu-thumb.active{border-color:var(--ink)}.ninu-thumb img{width:100%;height:100%;object-fit:cover}.n