           \n            <span class=\"ninu-tb-avatar\"><img src=\"https://cdn.shopify.com/s/files/1/1084/3894/6122/files/avatar3_small_2600b51b-b345-4f69-90f3-7804bd23786d.jpg?v=1793045428\" alt=\"\" loading=\"lazy\"></span>\n          </div>\n          <div>\n            <div class=\"ninu-tb-trusted-t\">Trusted by 10,000+ women</div>\n            <div class=\"ninu-tb-trusted-d\">Postpartum moms who made the switch. Their words, not ours.</div>\n          </div>\n        </div>\n\n      </section>\n\n      <script>\n(function(){\nvar SHIPS_WITHIN_BUSINESS_DAYS = 1;\nvar DELIVERY_MIN_BUSINESS_DAYS = 5;\nvar DELIVERY_MAX_BUSINESS_DAYS = 7;\nfunction addBusinessDays(date, days){\nvar result = new Date(date.getTime());\nvar added = 0;\nwhile (added < days) {\nresult.setDate(result.getDate() + 1);\nvar day = result.getDay(); // 0 = Sun, 6 = Sat\nif (day !== 0 && day !== 6) added++;\n}\nreturn result;\n}\nfunction formatDate(date){\nreturn date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });\n}\nvar today = new Date();\nvar shipDate = addBusinessDays(today, SHIPS_WITHIN_BUSINESS_DAYS);\nvar deliveryStart = addBusinessDays(shipDate, DELIVERY_MIN_BUSINESS_DAYS);\nvar deliveryEnd = addBusinessDays(shipDate, DELIVERY_MAX_BUSINESS_DAYS);\nvar shipEl = document.getElementById('ninu-tb-ship-date');\nif (shipEl) shipEl.textContent = formatDate(shipDate);\nvar delEl = document.getElementById('ninu-tb-delivery');\nif (delEl) {\ndelEl.textContent = 'Estimated delivery ' + formatDate(deliveryStart) + ' to ' +\nformatDate(deliveryEnd) + ' (' + DELIVERY_MIN_BUSINESS_DAYS + '-' +\nDELIVERY_MAX_BUSINESS_DAYS + ' business days)';\n}\n})();\n</script>\n    </div>\n  </div>\n\n  \n  <section class=\"ninu-ba\">\n    <div class=\"ninu-ba-inner\">\n      <div class=\"ninu-ba-eyebrow\">— Real results, month by month —</div>\n      <h2 class=\"ninu-ba-h2\">The receipts</h2>\n      <p class=\"ninu-ba-sub\">Postpartum moms, first-person crown-and-hairline shots, no filters, no glamour lighting. Their words, not ours.</p>\n\n      <div class=\"ninu-ba-scroller\">\n        <article class=\"ninu-ba-card\">\n          <div class=\"ninu-ba-split\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1084/3894/6122/files/ChatGPT_Image_Sep_30_2026_09_26_48_AM.png?v=1790774978\" alt=\"Rachel M. — split image showing temple hairline at month 2 next to month 5\">\n            <span class=\"ninu-ba-tag left\">Month 2</span>\n            <span class=\"ninu-ba-tag right\">Month 5</span>\n          </div>\n          <div class=\"ninu-ba-body\">\n            <div class=\"ninu-ba-stars\">★★★★★</div>\n            <blockquote>\"I stopped hiding my temples. Three months in, the fuzz is finally turning into actual hair.\"</blockquote>\n            <div class=\"ninu-ba-attrib\">Rachel M. · 5 months postpartum · verified buyer</div>\n          </div>\n        </article>\n\n        <article class=\"ninu-ba-card\">\n          <div class=\"ninu-ba-split\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1084/3894/6122/files/ChatGPT_Image_Sep_30_2026_09_29_10_AM.png?v=1790774978\" alt=\"Amara T. — split image showing crown at week 1 next to month 4\">\n            <span class=\"ninu-ba-tag left\">Week 1</span>\n            <span class=\"ninu-ba-tag right\">Month 4</span>\n          </div>\n          <div class=\"ninu-ba-body\">\n            <div class=\"ninu-ba-stars\">★★★★★</div>\n            <blockquote>\"The applicator actually gets oil to my scalp instead of my pillow. Life changer for how tired I am at night.\"</blockquote>\n            <div class=\"ninu-ba-attrib\">Amara T. · 6 months postpartum · verified buyer</div>\n          </div>\n        </article>\n\n        <article class=\"ninu-ba-card\">\n          <div class=\"ninu-ba-split\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1084/3894/6122/files/1c6dad8f-d2d2-4bb7-a1c3-0d00847e110d.png?v=1790774978\" alt=\"Jenna K. — split image showing hairline at month 3 next to month 6\">\n            <span class=\"ninu-ba-tag left\">Month 3</span>\n            <span class=\"ninu-ba-tag right\">Month 6</span>\n          </div>\n          <div class=\"ninu-ba-body\">\n            <div class=\"ninu-ba-stars\">★★★★★</div>\n            <blockquote>\"Six months in and my baby hairs finally look like part of my hair, not a halo of chaos around it.\"</blockquote>\n            <div class=\"ninu-ba-attrib\">Jenna K. · 8 months postpartum · verified buyer</div>\n          </div>\n        </article>\n      </div>\n\n      <div class=\"ninu-ba-dots\" aria-hidden=\"true\"><span></span><span></span><span></span></div>\n    </div>\n  </section>\n\n  \n  <div class=\"ninu-scrim\" id=\"ninu-scrim\" onclick=\"ninuCloseCart()\"></div>\n  <aside class=\"ninu-sidecart\" id=\"ninu-sidecart\" aria-hidden=\"true\">\n    <div class=\"ninu-sc-head\">\n      <div class=\"ninu-sc-title\">Your Ritual</div>\n      <button class=\"ninu-sc-close\" onclick=\"ninuCloseCart()\" aria-label=\"Close\">✕</button>\n    </div>\n    <div class=\"ninu-sc-body\" id=\"ninu-sc-body\">\n      <div class=\"ninu-empty\" id=\"ninu-empty\">Your cart is empty.</div>\n      <div id=\"ninu-lines\"></div>\n\n      \n      <div class=\"ninu-upsell\" id=\"ninu-upsell\" style=\"display:none\">\n        <div class=\"ninu-upsell-h\">Never run out</div>\n        <div class=\"ninu-upsell-t\">Add monthly oil refill</div>\n        <div class=\"ninu-upsell-d\">60ml, delivered monthly. Save $16 vs one-time ($32.99). Skip, pause or cancel any time.</div>\n        <div class=\"ninu-upsell-row\">\n          <div class=\"ninu-upsell-price\">$16.99<small> /month</small></div>\n          <button class=\"ninu-upsell-add\" id=\"ninu-upsell-btn\" onclick=\"ninuToggleRefill()\">Add to cart</button>\n        </div>\n      </div>\n\n      \n      <label class=\"ninu-protect\" id=\"ninu-protect\">\n        <span class=\"ninu-protect-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2 4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3zm-1 15-3-3 1.4-1.4L11 14.2l4.6-4.6L17 11l-6 6z\"/></svg>\n        </span>\n        <div class=\"ninu-protect-text\">\n          <div class=\"ninu-protect-t\">Shipping protection</div>\n          <div class=\"ninu-protect-d\">Covered against loss, theft or damage in transit.</div>\n        </div>\n        <div class=\"ninu-protect-side\">\n          <input type=\"checkbox\" id=\"ninu-protect-input\" onchange=\"ninuToggleProtection(this.checked)\">\n          <span class=\"ninu-protect-price\" id=\"ninu-protect-price\">—</span>\n          <span class=\"ninu-protect-check\" aria-hidden=\"true\"></span>\n        </div>\n      </label>\n\n      \n      <div class=\"ninu-stack\" id=\"ninu-stack\" style=\"display:none\">\n        <div class=\"ninu-stack-h\">What's included</div>\n        <ul id=\"ninu-stack-list\"></ul>\n      </div>\n\n      <div class=\"ninu-totals\" id=\"ninu-totals\" style=\"display:none\">\n        <div class=\"ninu-totals-row\"><span>Subtotal</span><span id=\"ninu-subtotal\">$0.00</span></div>\n        <div class=\"ninu-totals-row\"><span>Shipping</span><span style=\"color:var(--sage);font-weight:700\">FREE</span></div>\n        <div class=\"ninu-totals-row big\"><span>Total today</span><span id=\"ninu-total\">$0.00</span></div>\n      </div>\n    </div>\n    <div class=\"ninu-sc-foot\">\n      <button class=\"ninu-checkout\" id=\"ninu-checkout\" onclick=\"ninuCheckout()\" disabled>Secure Checkout →</button>\n      <div class=\"ninu-sc-note\" id=\"ninu-sc-note\">Your cart is empty.</div>\n    </div>\n  </aside>\n</div>\n\n<script>\n(function(){\n  // === REPLACE THESE FIVE VALUES ===================================\n  var KIT_VARIANT_ID = '63751529824586';           // The Ninu Kit\n  var DISPENSER_VARIANT_ID = '63751699595594';     // Ninu Applicator + Satin Bonnet\n  var REFILL_VARIANT_ID = '63751894630730';        // Rosemary Essential Oil Refill\n  var REFILL_SELLING_PLAN_ID = '693367669066';    // Monthly Refill · every 4 weeks · 48% off\n  var SHIPPING_PROTECTION_VARIANT_ID = '64051862405450'; // Shipping protection add-on\n  var MONEY_FORMAT = function(cents){ return '$' + (cents/100).toFixed(2); };\n  // =================================================================\n\n  var TIER = {\n    kit:       { title: 'The Ninu Kit',   price: 4999, variant: KIT_VARIANT_ID,\n                 includes: ['Ninu applicator dispenser','60ml scalp oil','Satin sleep bonnet','Free US shipping','30-day guarantee'] },\n    dispenser: { title: 'Ninu Dispenser', price: 3999, variant: DISPENSER_VARIANT_ID,\n                 includes: ['Ninu applicator dispenser','Satin sleep bonnet','Free US shipping','30-day guarantee'] }\n  };\n  var state = { tier: 'kit' };\n\n  window.ninuPick = function(el){\n    document.querySelectorAll('.ninu-tier').forEach(function(t){ t.classList.remove('selected'); t.querySelector('input').checked = false; });\n    el.classList.add('selected'); el.querySelector('input').checked = true;\n    state.tier = el.dataset.tier;\n    document.getElementById('ninu-atc-price').textContent = MONEY_FORMAT(TIER[state.tier].price);\n  };\n\n  window.ninuSwap = function(el, src){\n    document.querySelectorAll('.ninu-thumb').forEach(function(t){ t.classList.remove('active'); });\n    el.classList.add('active');\n    document.getElementById('ninu-hero').src = src;\n  };\n\n  window.ninuOpenCart = function(){\n    document.getElementById('ninu-sidecart').classList.add('open');\n    document.getElementById('ninu-sidecart').setAttribute('aria-hidden','false');\n    document.getElementById('ninu-scrim').classList.add('open');\n  };\n  window.ninuCloseCart = function(){\n    document.getElementById('ninu-sidecart').classList.remove('open');\n    document.getElementById('ninu-sidecart').setAttribute('aria-hidden','true');\n    document.getElementById('ninu-scrim').classList.remove('open');\n  };\n\n  // --- Shopify cart wiring -----------------------------------------\n  function ajaxAdd(items){\n    return fetch('/cart/add.js', {\n      method: 'POST',\n      headers: {'Content-Type':'application/json','Accept':'application/json'},\n      body: JSON.stringify({ items: items })\n    }).then(function(r){\n      return r.text().then(function(body){\n        if(!r.ok){\n          console.error('[Ninu] /cart/add.js failed', r.status, body);\n          var msg;\n          try { msg = JSON.parse(body).description || JSON.parse(body).message; } catch(e){ msg = body.slice(0,200); }\n          throw new Error('[' + r.status + '] ' + msg);\n        }\n        return JSON.parse(body);\n      });\n    });\n  }\n  function ajaxGetCart(){\n    return fetch('/cart.js', {headers:{'Accept':'application/json'}}).then(function(r){ return r.json(); });\n  }\n  function ajaxChange(line, quantity){\n    return fetch('/cart/change.js', {\n      method: 'POST',\n      headers: {'Content-Type':'application/json','Accept':'application/json'},\n      body: JSON.stringify({ line: line, quantity: quantity })\n    }).then(function(r){ return r.json(); });\n  }\n\n  window.ninuAdd = function(){\n    var btn = document.getElementById('ninu-atc');\n    btn.disabled = true;\n    var t = TIER[state.tier];\n    ajaxAdd([{ id: t.variant, quantity: 1 }])\n      .then(refreshCart)\n      .then(function(){ ninuOpenCart(); })\n      .catch(function(e){ console.error('[Ninu] add-to-cart error', e); alert('Add to cart failed: ' + (e.message || e)); })\n      .finally(function(){ btn.disabled = false; });\n  };\n\n  window.ninuToggleRefill = function(){\n    var upsell = document.getElementById('ninu-upsell');\n    var btn = document.getElementById('ninu-upsell-btn');\n    btn.disabled = true;\n    if(upsell.classList.contains('added')){\n      // Remove refill line\n      ajaxGetCart().then(function(cart){\n        var idx = cart.items.findIndex(function(i){ return String(i.variant_id) === String(REFILL_VARIANT_ID); });\n        if(idx >= 0) return ajaxChange(idx + 1, 0);\n      }).then(refreshCart).finally(function(){ btn.disabled = false; });\n    } else {\n      ajaxAdd([{ id: REFILL_VARIANT_ID, quantity: 1, selling_plan: REFILL_SELLING_PLAN_ID }])\n        .then(refreshCart)\n        .catch(function(e){ alert('Could not add refill. Check subscription setup.'); console.error(e); })\n        .finally(function(){ btn.disabled = false; });\n    }\n  };\n\n  window.ninuToggleProtection = function(checked){\n    var input = document.getElementById('ninu-protect-input');\n    input.disabled = true;\n    if(checked){\n      ajaxAdd([{ id: SHIPPING_PROTECTION_VARIANT_ID, quantity: 1 }])\n        .then(refreshCart)\n        .catch(function(e){ input.checked = false; alert('Could not add shipping protection: ' + (e.message || e)); console.error(e); })\n        .finally(function(){ input.disabled = false; });\n    } else {\n      ajaxGetCart().then(function(cart){\n        var idx = cart.items.findIndex(function(i){ return String(i.variant_id) === String(SHIPPING_PROTECTION_VARIANT_ID); });\n        if(idx >= 0) return ajaxChange(idx + 1, 0);\n      }).then(refreshCart).finally(function(){ input.disabled = false; });\n    }\n  };\n\n  function initProtectionPrice(){\n    fetch('/variants/' + SHIPPING_PROTECTION_VARIANT_ID + '.js', {headers:{'Accept':'application/json'}})\n      .then(function(r){ return r.ok ? r.json() : null; })\n      .then(function(v){\n        if(v && typeof v.price === 'number'){\n          document.getElementById('ninu-protect-price').textContent = '+ ' + MONEY_FORMAT(v.price);\n        }\n      })\n      .catch(function(){});\n  }\n\n  window.ninuRemoveLine = function(lineIdx){\n    ajaxChange(lineIdx + 1, 0).then(refreshCart);\n  };\n\n  window.ninuCheckout = function(){ window.location.href = '/checkout'; };\n\n  function refreshCart(){\n    return ajaxGetCart().then(renderCart);\n  }\n\n  function renderCart(cart){\n    document.getElementById('ninu-count').textContent = cart.item_count;\n    var linesEl = document.getElementById('ninu-lines');\n    var empty = document.getElementById('ninu-empty');\n    var stack = document.getElementById('ninu-stack');\n    var totals = document.getElementById('ninu-totals');\n    var upsell = document.getElementById('ninu-upsell');\n    var upsellBtn = document.getElementById('ninu-upsell-btn');\n    var checkout = document.getElementById('ninu-checkout');\n    var scNote = document.getElementById('ninu-sc-note');\n\n    if(!cart.items.length){\n      linesEl.innerHTML = '';\n      empty.style.display = 'block';\n      stack.style.display = 'none';\n      totals.style.display = 'none';\n      upsell.style.display = 'none';\n      checkout.disabled = true;\n      scNote.textContent = 'Add a kit to see your order.';\n      return;\n    }\n\n    empty.style.display = 'none';\n    checkout.disabled = false;\n\n    linesEl.innerHTML = cart.items.map(function(item, i){\n      var tierLabel = item.selling_plan_allocation ? 'Subscribe & save · monthly' : 'One-time · Qty ' + item.quantity;\n      return '<div class=\"ninu-line\">' +\n        '<div class=\"ninu-line-img\"><img src=\"' + (item.image || '') + '\" alt=\"\"></div>' +\n        '<div class=\"ninu-line-info\">' +\n          '<div class=\"ninu-line-title\">' + item.product_title + '</div>' +\n          '<div class=\"ninu-line-tier\">' + tierLabel + '</div>' +\n          '<div class=\"ninu-line-price\">' + MONEY_FORMAT(item.final_line_price) + '</div>' +\n          '<button class=\"ninu-line-remove\" onclick=\"ninuRemoveLine(' + i + ')\">Remove</button>' +\n        '</div>' +\n      '</div>';\n    }).join('');\n\n    // Offer stack — inferred from first kit/dispenser line\n    var kitLine = cart.items.find(function(i){ return String(i.variant_id) === String(KIT_VARIANT_ID) || String(i.variant_id) === String(DISPENSER_VARIANT_ID); });\n    if(kitLine){\n      var t = String(kitLine.variant_id) === String(KIT_VARIANT_ID) ? TIER.kit : TIER.dispenser;\n      document.getElementById('ninu-stack-list').innerHTML = t.includes.map(function(x){ return '<li><span class=\"k\">' + x + '</span><span class=\"v\">Included</span></li>'; }).join('');\n      stack.style.display = 'block';\n    } else {\n      stack.style.display = 'none';\n    }\n\n    // Refill upsell — show when kit/dispenser is in cart and refill isn't\n    var hasKit = !!kitLine;\n    var hasRefill = cart.items.some(function(i){ return String(i.variant_id) === String(REFILL_VARIANT_ID); });\n    if(hasKit){\n      upsell.style.display = 'block';\n      if(hasRefill){\n        upsell.classList.add('added');\n        upsellBtn.textContent = 'Remove';\n      } else {\n        upsell.classList.remove('added');\n        upsellBtn.textContent = 'Add to cart';\n      }\n    } else {\n      upsell.style.display = 'none';\n    }\n\n    // Shipping protection — show when kit/dispenser is in cart\n    var hasProtect = cart.items.some(function(i){ return String(i.variant_id) === String(SHIPPING_PROTECTION_VARIANT_ID); });\n    var protectEl = document.getElementById('ninu-protect');\n    var protectInput = document.getElementById('ninu-protect-input');\n    if(hasKit){\n      protectEl.classList.add('visible');\n      protectInput.checked = hasProtect;\n      protectEl.classList.toggle('checked', hasProtect);\n    } else {\n      protectEl.classList.remove('visible','checked');\n      protectInput.checked = false;\n    }\n\n    totals.style.display = 'block';\n    document.getElementById('ninu-subtotal').textContent = MONEY_FORMAT(cart.items_subtotal_price);\n    document.getElementById('ninu-total').textContent = MONEY_FORMAT(cart.total_price);\n    scNote.innerHTML = hasRefill ? 'Refills auto-ship monthly at $16.99. Skip, pause or cancel any time.' : 'Free US shipping · 30-day money-back guarantee.';\n  }\n\n  // Initial cart sync (in case items were added before this page loaded)\n  document.addEventListener('DOMContentLoaded', function(){ refreshCart().catch(function(){}); initProtectionPrice(); });\n})();\n</script>",
        "color_scheme": "background-1",
