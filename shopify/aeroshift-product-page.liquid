<!-- Sticky mobile bar -->
<div id="asx-sticky-bar" class="asx-sticky-bar">
  <strong id="asx-sticky-price">{{ product.selected_or_first_available_variant.price | money }}</strong>
  <button type="button" id="asx-sticky-add-btn">Add to Cart</button>
</div>

<script>
  window.ASX_VARIANTS = {{ product.variants | json }};
</script>
<script>
(function () {
  var root = document.getElementById('asx-product');
  if (!root) return;

  var variants = window.ASX_VARIANTS || [];

  var form = root.querySelector('#asx-form');
  var selectedVariantInput = root.querySelector('#asx-selected-variant');
  var priceEl = root.querySelector('#asx-price');
  var comparePriceEl = root.querySelector('#asx-compare-price');
  var addBtn = root.querySelector('#asx-add-btn');
  var qtyInput = root.querySelector('#asx-qty-input');
  var qtyMinus = root.querySelector('#asx-qty-minus');
  var qtyPlus = root.querySelector('#asx-qty-plus');
  var packButtons = root.querySelectorAll('.asx-pack');
  var thumbButtons = root.querySelectorAll('.asx-thumb');
  var mainImg = root.querySelector('#asx-main-img');

  var cartToggle = root.querySelector('#asx-cart-toggle');
  var cartOverlay = root.querySelector('#asx-cart-overlay');
  var cartDrawer = root.querySelector('#asx-cart-drawer');
  var cartClose = root.querySelector('#asx-cart-close');
  var cartCountEl = root.querySelector('#asx-cart-count');
  var cartItemsEl = root.querySelector('#asx-cart-items');
  var cartSubtotalEl = root.querySelector('#asx-cart-subtotal');

  var stickyBar = root.querySelector('#asx-sticky-bar');
  var stickyAddBtn = root.querySelector('#asx-sticky-add-btn');
  var stickyPriceEl = root.querySelector('#asx-sticky-price');
  var infoPanel = root.querySelector('.asx-info');

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function findVariant(id) {
    for (var i = 0; i < variants.length; i++) {
      if (String(variants[i].id) === String(id)) return variants[i];
    }
    return null;
  }

  function updateVariantUI(variantId) {
    var v = findVariant(variantId);
    if (!v) return;
    selectedVariantInput.value = v.id;
    priceEl.textContent = formatMoney(v.price);
    if (stickyPriceEl) stickyPriceEl.textContent = formatMoney(v.price);

    if (v.compare_at_price && v.compare_at_price > v.price) {
      comparePriceEl.textContent = formatMoney(v.compare_at_price);
      comparePriceEl.style.display = '';
    } else {
      comparePriceEl.style.display = 'none';
    }

    addBtn.textContent = v.available ? ('Add to Cart — ' + formatMoney(v.price)) : 'Sold Out';
    addBtn.disabled = !v.available;
    if (stickyAddBtn) stickyAddBtn.textContent = v.available ? 'Add to Cart' : 'Sold Out';
  }

  packButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      packButtons.forEach(function (b) { b.classList.remove('is-selected'); });
      btn.classList.add('is-selected');
      updateVariantUI(btn.getAttribute('data-variant-id'));
    });
  });

  thumbButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      thumbButtons.forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      mainImg.src = btn.getAttribute('data-full');
    });
  });

  if (qtyMinus) {
    qtyMinus.addEventListener('click', function () {
      var val = parseInt(qtyInput.value, 10) || 1;
      if (val > 1) qtyInput.value = val - 1;
    });
  }
  if (qtyPlus) {
    qtyPlus.addEventListener('click', function () {
      var val = parseInt(qtyInput.value, 10) || 1;
      qtyInput.value = val + 1;
    });
  }

  function openCart() {
    cartDrawer.classList.add('is-open');
    cartOverlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }
  function closeCart() {
    cartDrawer.classList.remove('is-open');
    cartOverlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }
  cartToggle.addEventListener('click', function () { openCart(); refreshCart(); });
  cartOverlay.addEventListener('click', closeCart);
  cartClose.addEventListener('click', closeCart);

  function renderCart(cart) {
    cartCountEl.textContent = cart.item_count;
    cartSubtotalEl.textContent = formatMoney(cart.total_price);

    if (cart.item_count === 0) {
      cartItemsEl.innerHTML = '<p class="asx-cart-empty">Your cart is empty.</p>';
      return;
    }

    var html = '';
    cart.items.forEach(function (item) {
      html +=
        '<div class="asx-cart-item">' +
          '<img src="' + item.image + '&width=160" alt="">' +
          '<div class="asx-cart-item-info">' +
            '<p class="asx-cart-item-title">' + item.product_title + '</p>' +
            '<p class="asx-cart-item-variant">' + (item.variant_title || '') + '</p>' +
            '<div class="asx-cart-item-qty">' +
              '<button type="button" class="asx-cart-qty-minus" data-key="' + item.key + '">–</button>' +
              '<span>' + item.quantity + '</span>' +
              '<button type="button" class="asx-cart-qty-plus" data-key="' + item.key + '">+</button>' +
            '</div>' +
          '</div>' +
          '<div class="asx-cart-item-price">' + formatMoney(item.line_price) + '</div>' +
          '<button type="button" class="asx-cart-item-remove" data-key="' + item.key + '" aria-label="Remove">×</button>' +
        '</div>';
    });
    cartItemsEl.innerHTML = html;

    cartItemsEl.querySelectorAll('.asx-cart-qty-minus').forEach(function (b) {
      b.addEventListener('click', function () { changeLineQty(b.getAttribute('data-key'), -1); });
    });
    cartItemsEl.querySelectorAll('.asx-cart-qty-plus').forEach(function (b) {
      b.addEventListener('click', function () { changeLineQty(b.getAttribute('data-key'), 1); });
    });
    cartItemsEl.querySelectorAll('.asx-cart-item-remove').forEach(function (b) {
      b.addEventListener('click', function () { changeLineQty(b.getAttribute('data-key'), 0, true); });
    });
  }

  function refreshCart() {
    fetch('/cart.js').then(function (r) { return r.json(); }).then(renderCart);
  }

  function changeLineQty(key, delta, remove) {
    fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
      var item = null;
      for (var i = 0; i < cart.items.length; i++) {
        if (cart.items[i].key === key) { item = cart.items[i]; break; }
      }
      if (!item) return;
      var newQty = remove ? 0 : Math.max(0, item.quantity + delta);
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: newQty })
      }).then(function (r) { return r.json(); }).then(renderCart);
    });
  }

  function addToCart(variantId, quantity) {
    addBtn.disabled = true;
    var originalText = addBtn.textContent;
    addBtn.textContent = 'Adding…';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: quantity })
    })
      .then(function (r) { return r.json(); })
      .then(function () { return fetch('/cart.js'); })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        renderCart(cart);
        openCart();
      })
      .catch(function () {
        alert('Something went wrong adding this to your cart. Please try again.');
      })
      .finally(function () {
        addBtn.disabled = false;
        addBtn.textContent = originalText;
      });
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    addToCart(selectedVariantInput.value, parseInt(qtyInput.value, 10) || 1);
  });

  if (stickyAddBtn) {
    stickyAddBtn.addEventListener('click', function () {
      addToCart(selectedVariantInput.value, parseInt(qtyInput.value, 10) || 1);
    });
  }

  if (stickyBar && infoPanel) {
    window.addEventListener('scroll', function () {
      var rect = infoPanel.getBoundingClientRect();
      if (rect.bottom < 0) {
        stickyBar.classList.add('is-visible');
      } else {
        stickyBar.classList.remove('is-visible');
      }
    });
  }

  refreshCart();
  updateVariantUI(selectedVariantInput.value);
})();
</script>
</div>
