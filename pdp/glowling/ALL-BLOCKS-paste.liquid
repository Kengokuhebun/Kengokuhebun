<script>
(function () {
  if (window.__glCartInit) return;
  window.__glCartInit = true;

  var ROOT = ({{ routes.root_url | json }} || '/').replace(/\/?$/, '/');
  var UPSELL = {{ gl_cart_upsell_handle | json }};
  // Free-shipping thresholds in cents, by cart currency. Match block 04. Remove a line to hide the bar for that currency.
  var FREE_SHIP = { USD: 5000, CAD: 7000, GBP: 4000, AUD: 7500 };

  var nativeFetch = window.fetch.bind(window);
  var root = document.getElementById('gl-cart');
  if (!root) return;
  document.body.appendChild(root);
  var $ = function (sel) { return root.querySelector(sel); };
  var els = {
    items: $('[data-gl-items]'), empty: $('[data-gl-empty]'), foot: $('[data-gl-foot]'),
    subtotal: $('[data-gl-subtotal]'), count: $('[data-gl-count]'), error: $('[data-gl-error]'),
    ship: $('[data-gl-ship]'), shipMsg: $('[data-gl-ship-msg]'), shipBar: $('[data-gl-ship-bar]'),
    upsell: $('[data-gl-upsell]'), checkout: $('[data-gl-checkout]')
  };
  els.checkout.setAttribute('href', ROOT + 'checkout');
  var upsellProduct = null, upsellLoaded = false, lastFocus = null;

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }
  function money(cents, cur) {
    try { return new Intl.NumberFormat(document.documentElement.lang || undefined, { style: 'currency', currency: cur }).format(cents / 100); }
    catch (e) { return (cents / 100).toFixed(2) + ' ' + cur; }
  }
  function img(url, w) { if (!url) return ''; return url + (url.indexOf('?') > -1 ? '&' : '?') + 'width=' + w; }
  function json(url, opts) {
    opts = opts || {};
    opts.headers = Object.assign({ 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, opts.headers || {});
    return nativeFetch(url, opts).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (d) {
        if (!r.ok) { var e = new Error(d.description || d.message || 'Something went wrong'); e.data = d; throw e; }
        return d;
      });
    });
  }
  function busy(on) { root.classList.toggle('is-busy', !!on); }
  function showError(msg) { els.error.textContent = msg || ''; els.error.hidden = !msg; }

  function open() {
    if (root.classList.contains('is-open')) return;
    lastFocus = document.activeElement;
    root.classList.add('is-open');
    root.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    var x = root.querySelector('.gl-cart__x'); if (x) x.focus();
  }
  function close() {
    root.classList.remove('is-open');
    root.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  function updateThemeCount(n) {
    var sel = '#cart-icon-bubble .cart-count-bubble span[aria-hidden="true"], [data-cart-count], .cart-count, .cart-count-bubble__count, .header__cart-count';
    document.querySelectorAll(sel).forEach(function (el) { if (!root.contains(el)) el.textContent = n; });
  }

  function renderShipping(cart) {
    var goal = FREE_SHIP[cart.currency];
    if (!goal || cart.item_count === 0) { els.ship.hidden = true; return; }
    els.ship.hidden = false;
    var left = goal - cart.total_price;
    els.shipMsg.innerHTML = left > 0
      ? 'You’re <strong>' + money(left, cart.currency) + '</strong> away from free shipping'
      : '🎉 You’ve unlocked <strong>free shipping</strong>';
    els.shipBar.style.width = Math.min(100, Math.round(cart.total_price / goal * 100)) + '%';
  }

  function renderUpsell(cart) {
    if (!UPSELL || !upsellProduct) { els.upsell.hidden = true; return; }
    var v = (upsellProduct.variants || []).filter(function (x) { return x.available; })[0];
    var inCart = cart.items.some(function (i) { return i.product_id === upsellProduct.id; });
    if (!v || inCart || cart.item_count === 0) { els.upsell.hidden = true; return; }
    var pic = upsellProduct.featured_image ? img(upsellProduct.featured_image.indexOf('//') === 0 ? 'https:' + upsellProduct.featured_image : upsellProduct.featured_image, 120) : '';
    els.upsell.innerHTML =
      '<p class="gl-cart__upsell-label">Add to your order</p>' +
      '<div class="gl-cart__upsell-row">' + (pic ? '<img src="' + esc(pic) + '" alt="">' : '<span></span>') +
      '<div><strong style="font-size:14px">' + esc(upsellProduct.title) + '</strong><div style="font-size:13px">' + money(v.price, cart.currency) + '</div></div>' +
      '<button type="button" data-gl-upsell-add="' + v.id + '">Add</button></div>';
    els.upsell.hidden = false;
  }

  function render(cart) {
    els.count.textContent = cart.item_count ? '(' + cart.item_count + ')' : '';
    updateThemeCount(cart.item_count);
    var empty = cart.item_count === 0;
    els.empty.hidden = !empty;
    els.foot.hidden = empty;
    els.items.innerHTML = cart.items.map(function (it) {
      var pic = it.featured_image && it.featured_image.url ? it.featured_image.url : it.image;
      var variant = it.variant_title && it.variant_title !== 'Default Title' ? '<p class="gl-cart__variant">' + esc(it.variant_title) + '</p>' : '<p class="gl-cart__variant"></p>';
      var compare = it.original_line_price > it.final_line_price ? '<span class="gl-cart__compare">' + money(it.original_line_price, cart.currency) + '</span>' : '';
      return '<li class="gl-cart__item">' +
        '<a href="' + esc(it.url) + '">' + (pic ? '<img src="' + esc(img(pic, 160)) + '" alt="' + esc(it.product_title) + '">' : '<img alt="">') + '</a>' +
        '<div><a class="gl-cart__name" href="' + esc(it.url) + '">' + esc(it.product_title) + '</a>' + variant +
        '<div class="gl-cart__qty"><button type="button" data-gl-qty="' + esc(it.key) + '" data-q="' + (it.quantity - 1) + '" aria-label="Decrease quantity">−</button>' +
        '<span>' + it.quantity + '</span>' +
        '<button type="button" data-gl-qty="' + esc(it.key) + '" data-q="' + (it.quantity + 1) + '" aria-label="Increase quantity">+</button></div>' +
        '<button type="button" class="gl-cart__remove" data-gl-qty="' + esc(it.key) + '" data-q="0">Remove</button></div>' +
        '<div class="gl-cart__price">' + compare + money(it.final_line_price, cart.currency) + '</div></li>';
    }).join('');
    els.subtotal.textContent = money(cart.total_price, cart.currency);
    renderShipping(cart);
    renderUpsell(cart);
  }

  function refresh() {
    var jobs = [json(ROOT + 'cart.js')];
    if (UPSELL && !upsellLoaded) {
      upsellLoaded = true;
      jobs.push(json(ROOT + 'products/' + encodeURIComponent(UPSELL) + '.js').then(function (p) { upsellProduct = p; }).catch(function () {}));
    }
    return Promise.all(jobs).then(function (r) { render(r[0]); return r[0]; });
  }
  function refreshAndOpen() { showError(''); return refresh().then(open); }

  // 1) Theme add-to-cart forms (capture phase runs before the theme's own handler)
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    var action = form.getAttribute('action') || '';
    if (!/\/cart\/add(\.js)?(\?|$)/.test(action)) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    var btn = form.querySelector('[type="submit"], button[name="add"]');
    if (btn) { btn.setAttribute('aria-disabled', 'true'); btn.disabled = true; }
    showError('');
    json(ROOT + 'cart/add.js', { method: 'POST', body: new FormData(form) })
      .then(refreshAndOpen)
      .catch(function (err) { refresh().then(function () { showError(err.message); open(); }); })
      .finally(function () { if (btn) { btn.disabled = false; btn.removeAttribute('aria-disabled'); } });
  }, true);

  // 2) Apps / theme scripts that add via fetch or XHR
  function isAdd(url) { return /\/cart\/add(\.js)?(\?|$)/.test(String(url || '')); }
  window.fetch = function (input, init) {
    var url = typeof input === 'string' ? input : (input && input.url);
    return nativeFetch(input, init).then(function (res) {
      if (isAdd(url) && res.ok) setTimeout(refreshAndOpen, 60);
      return res;
    });
  };
  var xOpen = XMLHttpRequest.prototype.open, xSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function (m, url) { this.__glUrl = url; return xOpen.apply(this, arguments); };
  XMLHttpRequest.prototype.send = function () {
    var xhr = this;
    if (isAdd(xhr.__glUrl)) xhr.addEventListener('load', function () { if (xhr.status >= 200 && xhr.status < 300) setTimeout(refreshAndOpen, 60); });
    return xSend.apply(this, arguments);
  };

  // 3) Header cart icon opens the drawer
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a || root.contains(a)) return;
    var path;
    try { path = new URL(a.href, location.href).pathname; } catch (_) { return; }
    if (/\/cart\/?$/.test(path) && a.origin === location.origin) {
      e.preventDefault();
      e.stopImmediatePropagation();
      refreshAndOpen();
    }
  }, true);

  // 4) Drawer controls
  root.addEventListener('click', function (e) {
    if (e.target.closest('[data-gl-close]')) { close(); return; }
    var q = e.target.closest('[data-gl-qty]');
    if (q) {
      busy(true); showError('');
      json(ROOT + 'cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: q.getAttribute('data-gl-qty'), quantity: Math.max(0, parseInt(q.getAttribute('data-q'), 10)) }) })
        .then(render).catch(function (err) { showError(err.message); }).finally(function () { busy(false); });
      return;
    }
    var u = e.target.closest('[data-gl-upsell-add]');
    if (u) {
      busy(true);
      json(ROOT + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: Number(u.getAttribute('data-gl-upsell-add')), quantity: 1 }] }) })
        .then(refresh).catch(function (err) { showError(err.message); }).finally(function () { busy(false); });
    }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && root.classList.contains('is-open')) close(); });

  window.GlowlingCart = { open: refreshAndOpen, close: close, refresh: refresh };
})();
</script>
