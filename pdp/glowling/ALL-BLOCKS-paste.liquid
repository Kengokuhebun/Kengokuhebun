<style>
  .gl-tiers{margin:4px 0 14px}
  .gl-tiers__title{display:flex;align-items:center;gap:10px;margin:0 0 10px;font-size:13px;font-weight:800;color:#1d2340;text-transform:uppercase;letter-spacing:.06em}
  .gl-tiers__title:before,.gl-tiers__title:after{content:'';flex:1;height:1px;background:#e3dccb}
  .gl-tier{position:relative;display:grid;grid-template-columns:22px 1fr auto;gap:4px 12px;align-items:center;padding:14px 14px 12px;margin:0 0 10px;border:2px solid #e3dccb;border-radius:12px;background:#fff;cursor:pointer;transition:border-color .15s,background .15s}
