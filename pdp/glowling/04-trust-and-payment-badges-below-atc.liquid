{%- comment -%}
  GLOWLING PDP · BLOCK 04 · Trust row + payment badges
  PASTE INTO: Product information → Custom Liquid block, directly BELOW the Buy buttons.
  Payment icons load from jsDelivr (version-pinned). Remove any <li> for a method you don't offer.
  The shipping line switches per market (Shopify Markets): put your real thresholds in each currency.
{%- endcomment -%}
{%- assign gl_guarantee_days = 30 -%}
{%- assign gl_ship_default = 'Fast tracked shipping' -%}
{%- case localization.country.iso_code -%}
  {%- when 'US' -%}{%- assign gl_ship = 'Free US shipping over $50' -%}
  {%- when 'CA' -%}{%- assign gl_ship = 'Free shipping in Canada over $70' -%}
  {%- when 'GB' -%}{%- assign gl_ship = 'Free UK delivery over £40' -%}
  {%- when 'AU' -%}{%- assign gl_ship = 'Free AU shipping over $75' -%}
  {%- else -%}{%- assign gl_ship = '' -%}
{%- endcase -%}
{%- if gl_ship == blank -%}{%- assign gl_ship = gl_ship_default -%}{%- endif -%}

<div class="gl-trust">
  <ul class="gl-trust__row">
    <li><span>🚚</span>{{ gl_ship }}</li>
    <li><span>🛡️</span>{{ gl_guarantee_days }}-day money-back guarantee</li>
    <li><span>🔒</span>Secure, encrypted checkout</li>
  </ul>
  <ul class="gl-pay" aria-label="Accepted payment methods">
    <li class="gl-pay__card"><img src="https://cdn.jsdelivr.net/npm/payment-icons@1.2.1/min/flat/visa.svg" alt="Visa" width="38" height="24" loading="lazy"></li>
    <li class="gl-pay__card"><img src="https://cdn.jsdelivr.net/npm/payment-icons@1.2.1/min/flat/mastercard.svg" alt="Mastercard" width="38" height="24" loading="lazy"></li>
    <li class="gl-pay__card"><img src="https://cdn.jsdelivr.net/npm/payment-icons@1.2.1/min/flat/amex.svg" alt="American Express" width="38" height="24" loading="lazy"></li>
    <li class="gl-pay__card"><img src="https://cdn.jsdelivr.net/npm/payment-icons@1.2.1/min/flat/discover.svg" alt="Discover" width="38" height="24" loading="lazy"></li>
    <li class="gl-pay__card"><img src="https://cdn.jsdelivr.net/npm/payment-icons@1.2.1/min/flat/paypal.svg" alt="PayPal" width="38" height="24" loading="lazy"></li>
    <li class="gl-pay__chip"><img src="https://cdn.jsdelivr.net/npm/simple-icons@13.21.0/icons/applepay.svg" alt="Apple Pay" width="30" height="16" loading="lazy"></li>
    <li class="gl-pay__chip"><img src="https://cdn.jsdelivr.net/npm/simple-icons@13.21.0/icons/googlepay.svg" alt="Google Pay" width="30" height="16" loading="lazy"></li>
    <li class="gl-pay__chip" style="background:#b2fce4"><img src="https://cdn.jsdelivr.net/npm/simple-icons@13.21.0/icons/afterpay.svg" alt="Afterpay" width="30" height="16" loading="lazy"></li>
    <li class="gl-pay__chip" style="background:#ffb3c7"><img src="https://cdn.jsdelivr.net/npm/simple-icons@13.21.0/icons/klarna.svg" alt="Klarna" width="30" height="16" loading="lazy"></li>
  </ul>
</div>

<style>
  .gl-trust{margin:12px 0 4px}
  .gl-trust__row{list-style:none;padding:0;margin:0 0 10px;display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
  .gl-trust__row li{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;font-size:12px;line-height:1.3;color:#1d2340;background:#fff8ec;border-radius:8px;padding:8px 4px}
  .gl-trust__row span{font-size:18px}
  .gl-pay{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;justify-content:center;gap:6px}
  .gl-pay li{display:flex;align-items:center;justify-content:center;width:40px;height:26px}
  .gl-pay__card img{width:40px;height:26px;display:block;border-radius:4px}
  .gl-pay__chip{background:#fff;border:1px solid #d9d9d9;border-radius:4px}
  .gl-pay__chip img{width:34px;height:20px;display:block;object-fit:contain}
</style>
