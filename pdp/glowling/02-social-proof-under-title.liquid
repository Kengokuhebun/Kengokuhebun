{%- comment -%}
  GLOWLING PDP · BLOCK 02 · Social proof line
  PASTE INTO: Product information → Custom Liquid block, directly UNDER the title / review stars.
  When you have real numbers, fill gl_rating and gl_family_count. Until then it shows the generic line.
{%- endcomment -%}
{%- assign gl_rating = '' -%}{%- comment -%} e.g. '4.8' from your review app {%- endcomment -%}
{%- assign gl_family_count = '' -%}{%- comment -%} e.g. '1,200' real orders {%- endcomment -%}

<div class="gl-proof">
  <div class="gl-proof__faces" aria-hidden="true">
    <span style="background:#ffd36e">👧</span><span style="background:#9be7d8">👦</span><span style="background:#ffb3c7">👵</span><span style="background:#b9c2ff">👨</span>
  </div>
  <p class="gl-proof__text">
    {%- if gl_family_count != blank -%}
      <span class="gl-proof__stars" aria-hidden="true">★★★★★</span>
      {%- if gl_rating != blank -%}<strong>{{ gl_rating }}/5</strong> · {% endif -%}
      {{ gl_family_count }}+ families have swapped some screen time for glow time
    {%- else -%}
      <strong>Loved by families</strong> in the US, UK, Canada &amp; Australia
    {%- endif -%}
  </p>
</div>

<style>
  .gl-proof{display:flex;align-items:center;gap:10px;margin:6px 0 12px}
  .gl-proof__faces{display:flex;flex-shrink:0}
  .gl-proof__faces span{width:28px;height:28px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:15px;margin-left:-8px}
  .gl-proof__faces span:first-child{margin-left:0}
  .gl-proof__text{margin:0;font-size:13px;line-height:1.4;color:#1d2340}
  .gl-proof__stars{color:#f5a623;letter-spacing:1px;margin-right:4px}
</style>
