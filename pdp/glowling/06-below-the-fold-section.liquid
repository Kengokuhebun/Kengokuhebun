<div class="gl-sec">

  <!-- 1. PROBLEM → SOLUTION -->
  <section class="gl-sec__block gl-sec__block--dark">
    <div class="gl-split">
      <div>
        <p class="gl-sec__eyebrow">For the part of the day the iPad usually wins</p>
        <h2 class="gl-sec__h2">Dinner to cook. A shower to squeeze in. The tablet is right there.</h2>
        <p class="gl-sec__p">Plenty of toys only last a few minutes once a tablet is in the room. Glowling lights up too, but here your child is the one making the picture, not watching one.</p>
        <p class="gl-sec__p">It won't replace every screen, and we won't pretend it does. It gives you something to try first, and a bit of quiet before the screen comes out.</p>
      </div>
      {%- if gl_src_problem != blank -%}
        <img width="1024" height="1024" class="gl-split__img" src="{{ gl_src_problem }}" alt="Child drawing on a glowing Glowling board while dinner is cooked" loading="lazy">
      {%- endif -%}
    </div>
  </section>

  <!-- 2. HOW IT WORKS -->
  <section class="gl-sec__block">
    <h2 class="gl-sec__h2 gl-center">How it works</h2>
    {%- if gl_src_steps != blank -%}
      <img width="1024" height="1024" class="gl-full-img" src="{{ gl_src_steps }}" alt="How Glowling works: draw, glow, wipe" loading="lazy">
    {%- endif -%}
    <ol class="gl-steps">
      <li><span class="gl-steps__n">1</span><strong>Plug it in</strong><span>USB cable into any phone charger or power bank.</span></li>
      <li><span class="gl-steps__n">2</span><strong>Draw in neon</strong><span>The fluorescent markers glow against the lit panel.</span></li>
      <li><span class="gl-steps__n">3</span><strong>Wipe and repeat</strong><span>A soft damp cloth clears it for the next masterpiece.</span></li>
    </ol>
  </section>

  <!-- 2b. FOUR WAYS TO USE IT -->
  {%- if gl_src_uses != blank -%}
  <section class="gl-sec__block">
    <h2 class="gl-sec__h2 gl-center">Four ways to use it</h2>
    <img width="1024" height="1024" class="gl-full-img gl-full-img--narrow" src="{{ gl_src_uses }}" alt="Four ways to use Glowling: drawing, letters and notes, tracing, night light" loading="lazy">
  </section>
  {%- endif -%}

  <!-- 3. COMPARISON -->
  <section class="gl-sec__block">
    <h2 class="gl-sec__h2 gl-center">Glowling vs the usual options</h2>
    {%- if gl_src_compare != blank -%}
      <img width="1024" height="1024" class="gl-full-img gl-full-img--narrow" src="{{ gl_src_compare }}" alt="Glow time vs screen time" loading="lazy">
    {%- endif -%}
    <table class="gl-table">
      <thead><tr><th></th><th class="gl-table__us">Glowling</th><th>Tablet</th><th>Paper &amp; crayons</th></tr></thead>
      <tbody>
        <tr><td>Lights up like a screen</td><td class="gl-table__us">✔</td><td>✔</td><td>✖</td></tr>
        <tr><td>Your child creates, not consumes</td><td class="gl-table__us">✔</td><td>✖</td><td>✔</td></tr>
        <tr><td>No apps, ads or autoplay</td><td class="gl-table__us">✔</td><td>✖</td><td>✔</td></tr>
        <tr><td>Reusable, no paper waste</td><td class="gl-table__us">✔</td><td>✔</td><td>✖</td></tr>
        <tr><td>Calm glow for bedtime</td><td class="gl-table__us">✔</td><td>✖</td><td>✖</td></tr>
      </tbody>
    </table>
  </section>

  <!-- 4. WHAT'S IN THE BOX -->
  <section class="gl-sec__block gl-sec__block--cream">
    <h2 class="gl-sec__h2 gl-center">What's in the box</h2>
    {%- if gl_src_box != blank -%}
      <img width="1024" height="1024" class="gl-full-img" src="{{ gl_src_box }}" alt="Everything in the Glowling box" loading="lazy">
    {%- endif -%}
    <ul class="gl-box">
      <li>1 × LED drawing board ({{ gl_board_size }})</li>
      <li>{{ gl_marker_count }} × fluorescent erasable markers</li>
      <li>1 × stand</li>
      <li>1 × USB cable</li>
      <li>Gift-ready packaging</li>
      <li><strong>FREE tracing book</strong> with every order</li>
    </ul>
  </section>

  <!-- 4b. DAY & NIGHT -->
  {%- if gl_src_collage != blank -%}
  <section class="gl-sec__block">
    <h2 class="gl-sec__h2 gl-center">From dinner time to bedtime</h2>
    <img width="1024" height="1024" class="gl-full-img gl-full-img--narrow" src="{{ gl_src_collage }}" alt="Glowling during the day and as a night light" loading="lazy">
  </section>
  {%- endif -%}

  <!-- 5. MORE REVIEWS: PLACEHOLDERS, replace with real reviews -->
  <section class="gl-sec__block">
    <h2 class="gl-sec__h2 gl-center">What families say</h2>
    <div class="gl-reviews">
      <figure class="gl-review">
        <div class="gl-review__stars">★★★★★</div>
        <blockquote>“I work from home and my 3-year-old used to get the TV for every call. Now she sits next to my desk drawing glowing fish for me. I still use the TV some days, but it isn't my first move anymore.”</blockquote>
        <figcaption><strong>Priya S.</strong> · Toronto, Canada</figcaption>
      </figure>
      <figure class="gl-review">
        <div class="gl-review__stars">★★★★★</div>
        <blockquote>“Bought two for my grandkids so they'd have something special at my house. The little one asks to 'do the glow' before she even takes her coat off.”</blockquote>
        <figcaption><strong>Margaret H.</strong> · Leeds, UK</figcaption>
      </figure>
      <figure class="gl-review">
        <div class="gl-review__stars">★★★★★</div>
        <blockquote>“We leave his last drawing up as a night light. Bedtime has gone from fighting over the tablet to picking which drawing stays on.”</blockquote>
        <figcaption><strong>Daniel R.</strong> · Brisbane, Australia</figcaption>
      </figure>
    </div>
  </section>

  <!-- 5b. OFFER + CTA -->
  <section class="gl-sec__block gl-center">
    {%- if gl_src_offer != blank -%}
      <img width="1024" height="1024" class="gl-full-img gl-full-img--narrow" src="{{ gl_src_offer }}" alt="Buy 2, Get 1 FREE plus a free tracing book" loading="lazy">
    {%- endif -%}
    <a href="#gl-tiers" class="gl-cta" data-gl-scroll-tiers>{{ gl_cta_text }}</a>
    <p class="gl-cta__note">🎁 FREE tracing book with every order</p>
  </section>

  <!-- 6. GUARANTEE -->
  <section class="gl-sec__block gl-guarantee">
    <div class="gl-guarantee__seal">{{ gl_guarantee_days }}<span>DAY</span></div>
    <div>
      <h2 class="gl-sec__h2">Try it for {{ gl_guarantee_days }} days</h2>
      <p class="gl-sec__p">If it doesn't earn a place in your evenings, email us within {{ gl_guarantee_days }} days and we'll refund you. No awkward questions.</p>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="gl-sec__block">
    <h2 class="gl-sec__h2 gl-center">Questions parents ask</h2>
    <details class="gl-faq"><summary>What age is it for?</summary><p>Recommended for ages {{ gl_age }}. Younger children should be supervised with the markers.</p></details>
    <details class="gl-faq"><summary>Isn't a glowing board just another screen?</summary><p>No. There's no app, no internet and nothing to watch. The light is only there to make your child's own drawing glow, and it does nothing until they pick up a marker.</p></details>
    <details class="gl-faq"><summary>Will the board scratch or smear?</summary><p>Use only the included markers and wipe with a soft damp cloth, not paper towel or anything abrasive. Let it dry before the next drawing and it stays clear.</p></details>
    <details class="gl-faq"><summary>Do the markers wipe off easily?</summary><p>Yes. A soft damp cloth clears the board. Keep the caps on between drawings so the markers don't dry out.</p></details>
    <details class="gl-faq"><summary>How is it powered?</summary><p>By the USB cable, from a phone charger, laptop or power bank. No batteries needed.</p></details>
    <details class="gl-faq"><summary>Can it be used as a night light?</summary><p>Yes. Many families leave a drawing up and use the glow for the bedtime wind-down.</p></details>
    <details class="gl-faq"><summary>How long does shipping take?</summary><p>We ship to the US, Canada, the UK and Australia. Delivery times for your country are shown at checkout, and you'll get a tracking link by email as soon as your order ships.</p></details>
    <details class="gl-faq"><summary>What if my child doesn't like it?</summary><p>You're covered by our {{ gl_guarantee_days }}-day money-back guarantee.</p></details>
  </section>
  <section class="gl-sec__block gl-center">
    <a href="#gl-tiers" class="gl-cta" data-gl-scroll-tiers>{{ gl_cta_text }}</a>
  </section>
</div>

<style>
  .gl-sec{max-width:1000px;margin:0 auto;padding:0 16px;color:#1d2340}
  .gl-sec__block{margin:0 0 28px;padding:24px 4px}
  .gl-sec__block--dark{background:#1d2340;color:#fff;border-radius:16px;padding:28px 20px}
  .gl-sec__block--dark .gl-sec__h2{color:#fff}
  .gl-sec__block--cream{background:#fff8ec;border-radius:16px;padding:24px 20px}
  .gl-sec__eyebrow{margin:0 0 6px;color:#ffd36e;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.06em}
  .gl-sec__h2{margin:0 0 12px;font-size:22px;line-height:1.25;font-weight:800;color:#1d2340}
  .gl-sec__p{margin:0 0 10px;font-size:15px;line-height:1.6}
  .gl-center{text-align:center}
  .gl-split{display:grid;gap:18px;align-items:center}
  .gl-split__img,.gl-full-img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;border-radius:12px;display:block}
  .gl-full-img{margin:0 0 16px}
  .gl-full-img--narrow{max-width:640px;margin:0 auto 16px}
  .gl-cta{display:inline-block;width:100%;max-width:440px;box-sizing:border-box;padding:16px 20px;border-radius:10px;background:#ffd84d;color:#1d2340;font-weight:800;font-size:17px;text-decoration:none;text-align:center}
  .gl-cta__note{margin:8px 0 0;font-size:13px;color:#4a4f66}
  .gl-steps{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr;gap:12px}
  .gl-steps li{background:#fff8ec;border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:4px;font-size:14px}
  .gl-steps__n{width:30px;height:30px;border-radius:50%;background:#1d2340;color:#ffd36e;font-weight:800;display:flex;align-items:center;justify-content:center}
  .gl-table{width:100%;border-collapse:collapse;font-size:13px;table-layout:fixed}
  .gl-table th,.gl-table td{padding:10px 4px;border-bottom:1px solid #e9e3d6;text-align:center;word-wrap:break-word}
  .gl-table th:first-child,.gl-table td:first-child{text-align:left;width:40%}
  .gl-table th{font-size:12px}
  .gl-table__us{background:#fff3cf;font-weight:800}
  .gl-box{list-style:none;padding:0;margin:0 auto;max-width:420px}
  .gl-box li{padding:8px 0 8px 28px;position:relative;font-size:15px;border-bottom:1px dashed #e0d6bf}
  .gl-box li:before{content:'✔';position:absolute;left:4px;color:#1a8f5a;font-weight:800}
  .gl-reviews{display:grid;grid-template-columns:1fr;gap:12px}
  .gl-review{margin:0;padding:16px;border:1px solid #e9e3d6;border-radius:12px;background:#fff}
  .gl-review__stars{color:#f5a623;letter-spacing:1px}
  .gl-review blockquote{margin:6px 0 8px;padding:0;border:0;font-style:italic;font-size:14px;line-height:1.5}
  .gl-review figcaption{font-size:12px;color:#4a4f66}
  .gl-guarantee{display:flex;gap:18px;align-items:center;border:2px solid #1d2340;border-radius:16px;padding:20px}
  .gl-guarantee__seal{flex-shrink:0;width:84px;height:84px;border-radius:50%;background:#ffd36e;color:#1d2340;font-weight:900;font-size:28px;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1}
  .gl-guarantee__seal span{font-size:12px;letter-spacing:.1em}
  .gl-faq{border-bottom:1px solid #e9e3d6;padding:12px 0}
  .gl-faq summary{cursor:pointer;font-weight:700;font-size:15px;list-style:none;position:relative;padding-right:24px}
  .gl-faq summary::-webkit-details-marker{display:none}
  .gl-faq summary:after{content:'+';position:absolute;right:4px;top:-2px;font-size:20px}
  .gl-faq[open] summary:after{content:'–'}
  .gl-faq p{margin:8px 0 0;font-size:14px;line-height:1.55}
  @media (min-width:750px){
    .gl-sec__h2{font-size:28px}
    .gl-steps,.gl-reviews{grid-template-columns:repeat(3,1fr)}
    .gl-split{grid-template-columns:1.2fr 1fr}
  }
</style>

<script>
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('[data-gl-scroll-tiers]');
    if (!a) return;
    var t = document.getElementById('gl-tiers') || document.querySelector('[data-gl-tiers]');
    if (!t) return;
    e.preventDefault();
    t.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
