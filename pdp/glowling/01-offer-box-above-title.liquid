{%- comment -%}
  GLOWLING PDP · BLOCK 01 · Offer box (place ABOVE the product title)
  Shows a different holiday cutoff per market, using the visitor's Shopify Markets country.
  Fill in each [date] with your real last-order date for that market. Only claim a ship time you can meet.
{%- endcomment -%}
{%- assign gl_offer_icon = '🎄' -%}
{%- assign gl_offer_sub = 'Ships in 1–2 business days, with tracking' -%}
{%- case localization.country.iso_code -%}
  {%- when 'US' -%}{%- assign gl_cutoff = '[Dec 15]' -%}
  {%- when 'CA' -%}{%- assign gl_cutoff = '[Dec 12]' -%}
  {%- when 'GB' -%}{%- assign gl_cutoff = '[15 December]' -%}
  {%- when 'AU' -%}{%- assign gl_cutoff = '[18 December]' -%}
  {%- else -%}{%- assign gl_cutoff = '' -%}
{%- endcase -%}

<div class="gl-offer">
  {%- if gl_cutoff != blank -%}
    <p class="gl-offer__headline">{{ gl_offer_icon }} Order by {{ gl_cutoff }} for holiday delivery</p>
  {%- else -%}
    <p class="gl-offer__headline">{{ gl_offer_icon }} The gift that glows this holiday season</p>
  {%- endif -%}
  <p class="gl-offer__sub">{{ gl_offer_sub }}</p>
</div>

<style>
  .gl-offer{border:2px solid #1d2340;border-radius:10px;background:#fff8ec;padding:12px 16px;text-align:center;margin:0 0 14px}
  .gl-offer__headline{margin:0;font-weight:800;font-size:17px;line-height:1.3;color:#1d2340}
  .gl-offer__sub{margin:4px 0 0;font-size:13px;color:#4a4f66}
  @media (min-width:750px){.gl-offer__headline{font-size:19px}}
</style>
