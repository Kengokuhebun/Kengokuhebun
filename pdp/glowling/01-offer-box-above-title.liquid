{%- comment -%}
  GLOWLING PDP · BLOCK 01 · Offer box (place ABOVE the product title)
  Edit the three lines below. Only claim local shipping if stock is really in Australia.
{%- endcomment -%}
{%- assign gl_offer_headline = 'Order by 18 December for Christmas delivery' -%}
{%- assign gl_offer_sub = 'Ships from our Australian warehouse in 1–2 business days' -%}
{%- assign gl_offer_icon = '🎄' -%}

<div class="gl-offer">
  <p class="gl-offer__headline">{{ gl_offer_icon }} {{ gl_offer_headline }}</p>
  <p class="gl-offer__sub">{{ gl_offer_sub }}</p>
</div>

<style>
  .gl-offer{border:2px solid #1d2340;border-radius:10px;background:#fff8ec;padding:12px 16px;text-align:center;margin:0 0 14px}
  .gl-offer__headline{margin:0;font-weight:800;font-size:17px;line-height:1.3;color:#1d2340}
  .gl-offer__sub{margin:4px 0 0;font-size:13px;color:#4a4f66}
  @media (min-width:750px){.gl-offer__headline{font-size:19px}}
</style>
